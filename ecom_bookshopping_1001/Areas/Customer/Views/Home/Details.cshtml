@model ecom_bookshopping_1001.Models.ShoppingCart

<form method="post">

   <input type="hidden" asp-for="@Model.ProductId" />
    <div class="container py-4">

        <div class="card border-0 shadow-lg overflow-hidden">

       
            <div class="card-header bg-white border-bottom py-4 px-4">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">

                    <div>
                        <h1 class="text-primary fw-bold mb-1">
                            @Model.product.Title
                        </h1>

                        <p class="text-muted mb-0">
                            <span class="fw-semibold">By</span> @Model.product.Author
                        </p>
                    </div>

                    @if (ViewBag.IsClearance == true)
                    {
                        <span class="badge bg-danger px-3 py-2 mt-3 mt-md-0">
                            <i class="fas fa-fire me-1"></i>
                            CLEARANCE SALE
                        </span>
                    }

                </div>

            </div>


            <div class="card-body p-4 p-lg-5">

                @if (ViewBag.IsClearance == true)
                {
                    <div class="alert alert-warning border-0 shadow-sm text-center mb-4">

                        <i class="fas fa-fire text-danger me-2"></i>

                        <strong>Clearance Sale!</strong>

                        Flat 10% OFF will be automatically applied at checkout.

                    </div>
                }
               

                <div class="row g-5 align-items-start">
                  
                    <div class="col-12 col-lg-7">

                        <div class="mb-4">

                            <span class="text-muted fw-semibold">
                                ISBN
                            </span>

                            <div class="fs-5 text-dark mt-1">
                                @Model.product.ISBN
                            </div>

                        </div>
                        
                            <!-- Category -->
                            <div class="col-12 col-md-6 mb-4">
                                <span class="text-muted fw-semibold">Category</span>
                                <div class="fs-5 text-dark mt-1">
                                    <span class="badge bg-secondary px-3 py-2">
                                    @Model.product.Category?.Name
                                    </span>
                                </div>
                            </div>

                            <!-- Cover Type -->
                            <div class="col-12 col-md-6 mb-4">
                                <span class="text-muted fw-semibold">Cover Type</span>
                                <div class="fs-5 text-dark mt-1">
                                    <span class="badge bg-info text-dark px-3 py-2">
                                    @Model.product.CopyType?.Name
                                    </span>
                                </div>
                            </div>
                        


                        <div class="mb-4">

                            <span class="text-muted fw-semibold">
                                List Price
                            </span>

                            <div class="fs-5 mt-1">
                                <del class="text-muted">
                                    $@Model.product.ListPrice.ToString("0.00")
                                </del>
                            </div>

                        </div>


                        <div class="mb-4">

                            <h5 class="fw-bold text-dark mb-3">
                                Pricing
                            </h5>

                            <div class="table-responsive">

                                <table class="table table-bordered text-center align-middle mb-0">

                                    <thead class="table-secondary">

                                        <tr>
                                            <th>Quantity</th>
                                            <th>1 - 49</th>
                                            <th>50 - 99</th>
                                            <th>100+</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        <tr>

                                            <th class="bg-light">
                                                Price
                                            </th>

                                            <td class="text-primary fw-bold">
                                                $@Model.product.Price.ToString("0.00")
                                            </td>

                                            <td class="text-primary fw-bold">
                                                $@Model.product.Price50.ToString("0.00")
                                            </td>

                                            <td class="text-primary fw-bold">
                                                $@Model.product.Price100.ToString("0.00")
                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <div class="mb-4">

                            <h5 class="fw-bold text-dark mb-3">
                                Description
                            </h5>

                            <div class="border-top pt-3 text-muted">

                                @Html.Raw(Model.product.Description)

                            </div>

                        </div>


                        <div class="row align-items-center mt-4">

                            <div class="col-auto">

                                <label for="quantity"
                                       class="fw-bold text-dark mb-0">
                                    Quantity
                                </label>

                            </div>

                            <div class="col-5 col-sm-4 col-md-3">

                                <input type="number"
                                       min="1"
                                       asp-for="@Model.Count"
                                       class="form-control form-control-lg text-center" />

                            </div>

                        </div>

                    </div>


                    <div class="col-12 col-lg-5">

                        <div class="position-relative text-center">

                            @if (ViewBag.IsClearance == true)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-danger px-3 py-2 shadow-sm"
                                      style="z-index:10;">

                                    <i class="fas fa-fire me-1"></i>
                                    10% OFF

                                </span>
                            }


                            <div class="bg-light rounded-3 p-4">

                                <img src="@Model.product.Imageurl"
                                     class="img-fluid rounded shadow-sm product-detail-image"
                                     alt="@Model.product.Title" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="card-footer bg-white border-top p-4">

                <div class="row g-3">

                    <div class="col-12 col-md-6">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary btn-lg w-100">

                            <i class="fas fa-arrow-left me-2"></i>
                            Back to List

                        </a>

                    </div>


                    <div class="col-12 col-md-6">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            <i class="fas fa-shopping-cart me-2"></i>
                            Add to Cart

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</form>
