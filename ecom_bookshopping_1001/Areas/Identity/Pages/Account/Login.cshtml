@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<h1 class="display-6 fw-bold mb-3">Log in</h1>
<div class="row">

    <div class="col-md-5">
        <section>
            <h4 class="fw-normal">Use a local account to log in.</h4>
            <hr />

            <form id="account" method="post">
                <!-- ReturnUrl ko track karne ke liye hidden field -->
                <input type="hidden" id="returnUrlHidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div id="login-error-alert" class="alert alert-danger d-none" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-primary py-2 fw-semibold mb-3">Log in</button>

                <div class="d-flex flex-column gap-1">
                    <div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">Forgot your password?</a>
                    </div>
                    <div>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Register as a new user</a>
                    </div>
                    <div>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none">Resend email confirmation</a>
                    </div>
                </div>
            </form>
        </section>
    </div>

    <div class="col-md-6 offset-md-1">
        <section>
            <h4 class="fw-normal">Use another service to log in.</h4>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p class="text-muted">
                            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715" class="text-decoration-none">
                            article
                            about setting up this ASP.NET application to support logging in via external services
                        </a>.
                    </p>
                </div>
            }
                else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                    <div>
                        <p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-primary me-2 mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                            }
                        </p>
                    </div>
                </form>
            }
        }
    </section>
</div>
</div>

<div class="modal fade" id="otpModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Enter Verification Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4">
                <p class="text-muted small">Humne aapke email par 6 digit ka security OTP bheja hai. Neeche enter karein:</p>
                <div class="my-3">
                    <input type="text" id="otpInput" class="form-control text-center fs-3 fw-bold" maxlength="6" placeholder="______" autocomplete="off" />
                </div>
                <div id="otpErrMsg" class="text-danger small fw-semibold"></div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" id="btnVerifyOtp" class="btn btn-success w-100 py-2 fs-6 fw-semibold" onclick="verifyEnteredOtp()">Verify & Login</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var otpModalInstance = null;

        $(document).ready(function () {
            otpModalInstance = new bootstrap.Modal(document.getElementById('otpModal'));

            $('#account').on('submit', function (e) {
                e.preventDefault();

                if (!$(this).valid()) {
                    return false;
                }

                var $submitBtn = $('#login-submit');
                var $errAlert = $('#login-error-alert');

                $submitBtn.prop('disabled', true).text('Sending OTP...');
                $errAlert.addClass('d-none').text('');

                var payload = {
                    Email: $('input[name="Input.Email"]').val(),
                    Password: $('input[name="Input.Password"]').val(),
                    RememberMe: $('input[name="Input.RememberMe"]').is(':checked'),
                    ReturnUrl: $('#returnUrlHidden').val() // ReturnUrl pass kiya
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    type: "POST",
                    url: window.location.pathname + "?handler=SendLoginOtp",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(payload),
                    headers: { "RequestVerificationToken": token },
                    success: function (res) {
                        $submitBtn.prop('disabled', false).text('Log in');
                        if (res.success) {
                            $('#otpInput').val('');
                            $('#otpErrMsg').text('');
                            otpModalInstance.show();
                        } else {
                            $errAlert.removeClass('d-none').text(res.message);
                        }
                    },
                    error: function () {
                        $submitBtn.prop('disabled', false).text('Log in');
                        $errAlert.removeClass('d-none').text('Server se connect nahi ho paya.');
                    }
                });
            });
        });

        function verifyEnteredOtp() {
            var otpVal = $('#otpInput').val().trim();
            var $errDiv = $('#otpErrMsg');
            var $verifyBtn = $('#btnVerifyOtp');

            if (otpVal.length !== 6) {
                $errDiv.text('Kripya pura 6 digit OTP enter karein.');
                return;
            }

            $verifyBtn.prop('disabled', true).text('Verifying...');
            $errDiv.text('');

            var token = $('input[name="__RequestVerificationToken"]').val();

            var payload = {
                EnteredOtp: otpVal,
                ReturnUrl: $('#returnUrlHidden').val() // ReturnUrl verify request me pass kiya
            };

            $.ajax({
                type: "POST",
                url: window.location.pathname + "?handler=VerifyLoginOtp",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(payload),
                headers: { "RequestVerificationToken": token },
                success: function (res) {
                    $verifyBtn.prop('disabled', false).text('Verify & Login');
                    if (res.success) {
                        // Agar server se valid redirect URL mila hai toh wahi bhejega
                        window.location.href = res.returnUrl || "/";
                    } else {
                        $errDiv.text(res.message);
                    }
                },
                error: function () {
                    $verifyBtn.prop('disabled', false).text('Verify & Login');
                    $errDiv.text('Verification fail ho gayi.');
                }
            });
        }
    </script>
}