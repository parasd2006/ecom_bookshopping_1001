<div class="row">
    <div class="col-9">
        <h2 >Product</h2>
    </div>
    <div class="col-3">
        <a asp-action="Upsert" class=" btn btn-info form-control"><i class="fas fa-plus"></i>
            &hearts; Add New Product</a>
    </div>
</div>
<div class="container rounded border p-2 m-2">
    <table id="tblData" class="table table-hover table-striped table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>
@section Scripts{
    <script src="~/js/Product.js"></script>
}