@model ecom_bookshopping_1001.Models.Company

@{
    var title = Model.Id != 0 ? "Edit Company" : "Save Company";
}

<form method="post">

    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="container py-4">

        <div class="row">

            <div class="col-12">
                <h2 class="text-primary fw-bold mb-4">@title</h2>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="col-12 col-md-8">
              
     <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                    </div>

                    <div class="col-8">
                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter company name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>
                </div>


               
                <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="StreetAddress"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">
                        <input asp-for="StreetAddress"
                               class="form-control"
                               placeholder="Enter street address" />

                        <span asp-validation-for="StreetAddress"
                              class="text-danger">
                        </span>
                    </div>
                </div>


                
                <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="City"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">
                        <input asp-for="City"
                               class="form-control"
                               placeholder="Enter city" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>
                    </div>
                </div>


             
                <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="State"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">
                        <input asp-for="State"
                               class="form-control"
                               placeholder="Enter state" />

                        <span asp-validation-for="State"
                              class="text-danger">
                        </span>
                    </div>
                </div>


               
                <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="PostalCode"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">
                        <input asp-for="PostalCode"
                               class="form-control"
                               placeholder="Enter postal code" />

                        <span asp-validation-for="PostalCode"
                              class="text-danger">
                        </span>
                    </div>
                </div>


               
                <div class="form-group row mb-3">
                    <div class="col-4">
                        <label asp-for="PhoneNumber"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>
                    </div>
                </div>


              
                <div class="form-group row mb-4">
                    <div class="col-4">
                        <label asp-for="IsAuthorizedCompany"
                               class="form-label fw-bold">
                        </label>
                    </div>

                    <div class="col-8">

                        <div class="form-check form-switch">
                            <input asp-for="IsAuthorizedCompany"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label class="form-check-label">
                                Authorized Company
                            </label>
                        </div>

                        <span asp-validation-for="IsAuthorizedCompany"
                              class="text-danger">
                        </span>

                    </div>
                </div>


               
                <div class="form-group row mt-4">

                    <div class="col-12">

                        @if (Model.Id != 0)
                        {
                            <partial name="_EditAndBackToList" />
                        }
                        else
                        {
                            <partial name="_createAndBackToListButton" />
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section scripts{
    <partial name="_ValidationScriptsPartial" />

}