@model ecom_bookshopping_1001.Models.Category
@{
    var title = Model.Id != 0 ? "Update Category" : "New Category";
    var saveupdate = Model.Id != 0 ? "Update" : "Save";
}
<form method="post">
@if(Model.Id!=0)
{
    <input type="hidden" asp-for="Id"/>

}
<div class="col-10">
    <h2 class="text-primary text-center">@title</h2>
</div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-8">
    <div class="form-group row p-2 m-2">
        <div class="col-4">
            <label asp-for="Name"></label>
        </div>
        <div class="col-8">
            <input asp-for="Name" class="form-control text-black"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row p-2 m-2">
        <div class="col-8 offset-4">
            @if(Model.Id!=0)
                    {
                    <partial name="_EditAndBackToList" />
                    }else
                    {
                    <partial name="_createAndBackToListButton" />
                    }
                </div>
    </div>
    @* <div class="form-group row p-2 m-2">
        <div class="col-4 offset-4">
            <button type="submit" class="btn btn-info form-control">@saveupdate</button>
        </div>
        <div class="col-4">
           <a asp-action="Index" class="btn btn-danger form-control">Back To List</a>
        </div>
    </div> *@
</div>
</form>